<div class="kuwayt-brand spacing-style" style="{% render 'spacing-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  {% if block.settings.show_mark %}
    <img
      class="kuwayt-brand__mark"
      src="{{ 'kuwayt_shopify_icon_512x512.png' | asset_url }}"
      alt=""
      width="72"
      height="72"
      loading="lazy"
    >
  {% endif %}

  {% if block.settings.heading != blank %}
    <p class="kuwayt-brand__name">{{ block.settings.heading | escape }}</p>
  {% endif %}

  {% if block.settings.tagline != blank %}
    <p class="kuwayt-brand__tagline">{{ block.settings.tagline | escape }}</p>
  {% endif %}

  {% if block.settings.text != blank %}
    <div class="kuwayt-brand__text rte">{{ block.settings.text }}</div>
  {% endif %}
</div>

{% stylesheet %}
  .kuwayt-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    max-width: 22rem;
  }

  .kuwayt-brand__mark {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 1rem;
    object-fit: cover;
  }

  .kuwayt-brand__name {
    margin: 0.25rem 0 0;
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .kuwayt-brand__tagline {
    margin: 0;
    color: #ffe45c;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .kuwayt-brand__text {
    margin: 0.25rem 0 0;
    max-width: 28ch;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KUWAYT brand",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_mark",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Name",
      "default": "KUWAYT"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "ONE STOP FOR ALL"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Electronics, fashion, home, beauty and everyday essentials in one store.</p>"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
