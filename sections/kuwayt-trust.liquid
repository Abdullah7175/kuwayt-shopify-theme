<div
  class="kuwayt-trust"
  aria-label="{{ section.settings.heading | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="section section--page-width">
    <ul class="kuwayt-trust__list" role="list">
      {% for block in section.blocks %}
        <li class="kuwayt-trust__item" {{ block.shopify_attributes }}>
          <span class="kuwayt-trust__title">{{ block.settings.title | escape }}</span>
          {% if block.settings.text != blank %}
            <span class="kuwayt-trust__text">{{ block.settings.text | escape }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .kuwayt-trust {
    background: #fff;
    border-block: 1px solid #e4e7ea;
  }

  .kuwayt-trust__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
  }

  .kuwayt-trust__item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.95rem 1rem;
  }

  .kuwayt-trust__item + .kuwayt-trust__item {
    border-inline-start: 1px solid #e4e7ea;
  }

  .kuwayt-trust__title {
    color: #202124;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .kuwayt-trust__text {
    color: #5f6368;
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  @media screen and (max-width: 749px) {
    .kuwayt-trust__list {
      grid-template-columns: 1fr 1fr;
    }

    .kuwayt-trust__item:nth-child(odd) {
      border-inline-start: 0;
    }

    .kuwayt-trust__item:nth-child(n + 3) {
      border-block-start: 1px solid #e4e7ea;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KUWAYT highlights",
  "tag": "section",
  "class": "kuwayt-trust-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Accessible label",
      "default": "Store highlights"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Highlight"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "KUWAYT highlights",
      "category": "Text"
    }
  ]
}
{% endschema %}
