<div class="kuwayt-contact" {{ section.shopify_attributes }}>
  <div class="section section--page-width kuwayt-contact__layout">
    <div class="kuwayt-contact__intro">
      <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
      {% if section.settings.introduction != blank %}
        <div class="rte">{{ section.settings.introduction }}</div>
      {% elsif page.content != blank %}
        <div class="rte">{{ page.content }}</div>
      {% else %}
        <p>Send a message and the store can reply to the email address you enter.</p>
      {% endif %}

      {% if section.settings.email != blank or section.settings.phone != blank %}
        <ul class="kuwayt-contact__details" role="list">
          {% if section.settings.email != blank %}
            <li>
              <span>Email</span>
              <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
            </li>
          {% endif %}
          {% if section.settings.phone != blank %}
            <li>
              <span>Phone</span>
              <a href="tel:{{ section.settings.phone | escape }}">{{ section.settings.phone | escape }}</a>
            </li>
          {% endif %}
        </ul>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="kuwayt-contact__faq">
          <h2>Common questions</h2>
          {% for block in section.blocks %}
            {% if block.settings.question != blank and block.settings.answer != blank %}
              <details {{ block.shopify_attributes }}>
                <summary>{{ block.settings.question | escape }}</summary>
                <div class="rte">{{ block.settings.answer }}</div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="kuwayt-contact__form">
      {% form 'contact', id: 'KuwaytContact', class: 'kuwayt-contact__fields' %}
        {% if form.posted_successfully? %}
          <p class="kuwayt-contact__status" role="status" tabindex="-1" autofocus>
            Your message has been sent.
          </p>
        {% endif %}

        {% if form.errors %}
          <div class="kuwayt-contact__status kuwayt-contact__status--error" role="alert" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <label>
          Name
          <input
            type="text"
            name="contact[name]"
            autocomplete="name"
            required
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          >
        </label>
        <label>
          Email
          <input
            type="email"
            name="contact[email]"
            autocomplete="email"
            required
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          >
        </label>
        <label>
          Phone
          <input
            type="tel"
            name="contact[phone]"
            autocomplete="tel"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          >
        </label>
        <label>
          Message
          <textarea name="contact[body]" required rows="6">{{ form.body }}</textarea>
        </label>
        <button class="button" type="submit">Send message</button>
      {% endform %}
    </div>
  </div>
</div>

{% stylesheet %}
  .kuwayt-contact {
    padding-block: 2.5rem 3.5rem;
    background: #f7f8fa;
    color: #202124;
  }

  .kuwayt-contact__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2rem;
    align-items: start;
  }

  .kuwayt-contact h1,
  .kuwayt-contact h2 {
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .kuwayt-contact__details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .kuwayt-contact__details span {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #5f6368;
  }

  .kuwayt-contact__details a {
    color: #009eaa;
  }

  .kuwayt-contact__faq {
    margin-top: 1.75rem;
  }

  .kuwayt-contact details {
    border-top: 1px solid #e4e7ea;
    padding-block: 0.75rem;
  }

  .kuwayt-contact summary {
    cursor: pointer;
    font-weight: 600;
  }

  .kuwayt-contact__form {
    padding: 1.25rem;
    background: #fff;
    border: 1px solid #e4e7ea;
    border-radius: 0.75rem;
    box-shadow: 0 8px 24px rgb(32 33 36 / 5%);
  }

  .kuwayt-contact__fields {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .kuwayt-contact label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .kuwayt-contact input,
  .kuwayt-contact textarea {
    width: 100%;
    padding: 0.75rem 0.85rem;
    border: 1px solid #d5d8dc;
    border-radius: 0.5rem;
    font: inherit;
    font-weight: 400;
    color: #202124;
    background: #fff;
  }

  .kuwayt-contact__status {
    margin: 0;
    padding: 0.75rem 0.85rem;
    border-radius: 0.5rem;
    background: #e8f8ec;
  }

  .kuwayt-contact__status--error {
    background: #fff4f2;
  }

  @media screen and (max-width: 749px) {
    .kuwayt-contact__layout {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the page title."
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "Introduction",
      "info": "Leave blank to use the page content."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "info": "Shown only when filled in. Leave blank if the store has not published an email."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Support phone",
      "info": "Shown only when filled in. Leave blank if the store has not published a phone number."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
