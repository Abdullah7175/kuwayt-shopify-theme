<div
  class="kuwayt-newsletter"
  style="--kuwayt-newsletter-pad: {{ section.settings.padding }}px;"
  {{ section.shopify_attributes }}
>
  <div class="section section--page-width">
    <div class="kuwayt-newsletter__panel">
      <div class="kuwayt-newsletter__copy">
        {% if section.settings.heading != blank %}
          <h2 class="kuwayt-newsletter__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="kuwayt-newsletter__text rte">{{ section.settings.text }}</div>
        {% endif %}
      </div>

      {% form 'customer', class: 'kuwayt-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {% if form.posted_successfully? %}
          <p class="kuwayt-newsletter__success" role="status">{{ section.settings.success | escape }}</p>
        {% else %}
          <label class="visually-hidden" for="KuwaytNewsletter-{{ section.id }}">
            {{ 'blocks.contact_form.email' | t }}
          </label>
          <input
            id="KuwaytNewsletter-{{ section.id }}"
            class="kuwayt-newsletter__input"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            autocomplete="email"
            required
            placeholder="{{ section.settings.placeholder | escape }}"
          >
          <button class="kuwayt-newsletter__submit" type="submit">
            {{ section.settings.button_label | escape }}
          </button>
          {% if form.errors %}
            <div class="kuwayt-newsletter__errors">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

{% stylesheet %}
  .kuwayt-newsletter {
    padding-block: var(--kuwayt-newsletter-pad);
    background: #fff;
  }

  .kuwayt-newsletter__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 28rem);
    gap: 1.5rem 2rem;
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 1.25rem;
    background: #009eaa;
    color: #fff;
  }

  .kuwayt-newsletter__heading {
    margin: 0;
    font-size: clamp(1.6rem, 2.4vw, 2.25rem);
    letter-spacing: -0.03em;
  }

  .kuwayt-newsletter__text {
    margin: 0.4rem 0 0;
    max-width: 42ch;
    color: rgb(255 255 255 / 88%);
  }

  .kuwayt-newsletter__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .kuwayt-newsletter__input {
    flex: 1 1 12rem;
    min-height: 3rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: #202124;
    font: inherit;
  }

  .kuwayt-newsletter__submit {
    min-height: 3rem;
    padding: 0 1.25rem;
    border: 0;
    border-radius: 999px;
    background: #ffe45c;
    color: #202124;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .kuwayt-newsletter__submit:hover {
    background: #fff4a8;
  }

  .kuwayt-newsletter__success,
  .kuwayt-newsletter__errors {
    flex: 1 1 100%;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .kuwayt-newsletter__panel {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KUWAYT newsletter",
  "tag": "section",
  "class": "kuwayt-newsletter-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get the KUWAYT list"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>New arrivals and store news. No made-up discounts, just what is actually in the catalog.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success",
      "label": "Success message",
      "default": "You are on the list."
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "KUWAYT newsletter",
      "category": "Forms"
    }
  ]
}
{% endschema %}
