{%- liquid
  assign visible_tiles = 0
  for block in section.blocks
    assign tile_collection = block.settings.collection
    if tile_collection == blank and block.settings.handle != blank
      assign tile_collection = collections[block.settings.handle]
    endif
    if tile_collection.id == blank
      assign tile_collection = blank
    endif
    if tile_collection != blank or block.settings.link != blank or block.settings.manual_url != blank
      assign visible_tiles = visible_tiles | plus: 1
    endif
  endfor
-%}
{% if visible_tiles > 0 or request.design_mode %}
  <div class="kuwayt-shop-by" {{ section.shopify_attributes }}>
    <div class="section section--page-width">
      {% if section.settings.heading != blank %}
        <h2 class="kuwayt-shop-by__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if request.design_mode and visible_tiles == 0 %}
        <p class="kuwayt-editor-note">Add a collection or a link to each tile. Empty tiles stay hidden on the storefront.</p>
      {% endif %}
      <ul class="kuwayt-shop-by__row" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign tile_collection = block.settings.collection
            if tile_collection == blank and block.settings.handle != blank
              assign tile_collection = collections[block.settings.handle]
            endif
            if tile_collection.id == blank
              assign tile_collection = blank
            endif
            assign tile_url = block.settings.link
            if tile_url == blank and block.settings.manual_url != blank
              assign tile_url = block.settings.manual_url
            endif
            if tile_url == blank and tile_collection != blank
              assign tile_url = tile_collection.url
            endif
            assign tile_label = block.settings.title
            if tile_label == blank and tile_collection != blank
              assign tile_label = tile_collection.title
            endif
            assign tile_image = block.settings.image
            if tile_image == blank and tile_collection.featured_image != blank
              assign tile_image = tile_collection.featured_image
            endif
            assign hide_tile = false
            if request.design_mode == false and tile_url == blank
              assign hide_tile = true
            endif
          %}
          {% unless hide_tile or tile_label == blank %}
            <li {{ block.shopify_attributes }}>
              <a class="kuwayt-shop-by__tile" href="{{ tile_url | default: '#' }}">
                {% if tile_image != blank %}
                  <span class="kuwayt-shop-by__media">
                    {{
                      tile_image
                      | image_url: width: 640
                      | image_tag:
                        widths: '160, 240, 360, 480, 640',
                        sizes: '(min-width: 990px) 18vw, 40vw',
                        loading: 'lazy',
                        alt: '',
                        width: tile_image.width,
                        height: tile_image.height
                    }}
                  </span>
                {% endif %}
                <span class="kuwayt-shop-by__label">{{ tile_label | escape }}</span>
              </a>
            </li>
          {% endunless %}
        {% endfor %}
      </ul>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Shop by",
  "tag": "section",
  "class": "kuwayt-shop-by-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by department"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Department"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Collection handle",
          "info": "Used when the collection picker is empty."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "manual_url",
          "label": "Manual URL",
          "info": "Use for a price-filter link such as /collections/all?filter.v.price.lte=100000"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by"
    }
  ]
}
{% endschema %}
