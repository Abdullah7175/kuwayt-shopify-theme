<div class="kuwayt-home-banner">
  <div class="kuwayt-banner-grid">
    <kuwayt-hero
  class="kuwayt-hero"
  {% if section.settings.autoplay and section.blocks.size > 1 %}
    autoplay="{{ section.settings.speed }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="kuwayt-hero__viewport">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% render 'kuwayt-hero-slide', block: block, index: forloop.index0, active: forloop.first %}
      {% endfor %}
    {% else %}
      <article class="kuwayt-hero__slide is-active">
        <div class="kuwayt-hero__media">
          <img
            src="{{ 'kuwayt_primary_logo_high_res.png' | asset_url }}"
            alt="{{ section.settings.image_alt | escape }}"
            width="1600"
            height="640"
          >
        </div>
        <div class="kuwayt-hero__copy section section--page-width">
          {% if section.settings.eyebrow != blank %}
            <p class="kuwayt-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h1 class="kuwayt-hero__heading">{{ section.settings.heading | escape }}</h1>
          {% endif %}
          {% if section.settings.text != blank %}
            <div class="kuwayt-hero__text rte">{{ section.settings.text }}</div>
          {% endif %}
          {% if section.settings.primary_label != blank %}
            <a class="button kuwayt-hero__button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
              {{ section.settings.primary_label | escape }}
            </a>
          {% endif %}
        </div>
      </article>
    {% endif %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="kuwayt-hero__controls section section--page-width">
      <button class="kuwayt-hero__arrow" type="button" data-dir="-1" aria-label="Previous slide">
        <span aria-hidden="true">&#8249;</span>
      </button>
      <div class="kuwayt-hero__dots" role="tablist" aria-label="Slides">
        {% for block in section.blocks %}
          <button
            class="kuwayt-hero__dot{% if forloop.first %} is-active{% endif %}"
            type="button"
            role="tab"
            aria-label="Slide {{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-index="{{ forloop.index0 }}"
          ></button>
        {% endfor %}
      </div>
      <button class="kuwayt-hero__arrow" type="button" data-dir="1" aria-label="Next slide">
        <span aria-hidden="true">&#8250;</span>
      </button>
    </div>
  {% endif %}
</kuwayt-hero>
<div class="kuwayt-side-banners">

  <a href="{{ section.settings.side_banner_link | default: routes.all_products_collection_url }}">
    {% if section.settings.side_banner_1 != blank %}
      {{ section.settings.side_banner_1 | image_url: width: 800 | image_tag }}
      <span class="kuwayt-banner-btn">Shop Now</span>
    {% endif %}
  </a>

  <a href="{{ routes.all_products_collection_url }}">
    {% if section.settings.side_banner_2 != blank %}
      {{ section.settings.side_banner_2 | image_url: width: 800 | image_tag }}
    {% endif %}
  </a>

</div>
</div>

<div class="kuwayt-bottom-banner">
  {% if section.settings.bottom_banner != blank %}
<a href="{{ section.settings.bottom_banner_link | default: routes.all_products_collection_url }}">
        {{ section.settings.bottom_banner | image_url: width: 1800 | image_tag }}
    </a>
    <span class="kuwayt-banner-btn">Shop Now</span>
  {% endif %}
</div>

</div>
{% javascript %}
  if (!customElements.get('kuwayt-hero')) {
    class KuwaytHero extends HTMLElement {
      connectedCallback() {
        this.slides = [...this.querySelectorAll('.kuwayt-hero__slide')];
        this.dots = [...this.querySelectorAll('.kuwayt-hero__dot')];
        this.index = 0;
        this.querySelectorAll('[data-dir]').forEach((button) => {
          button.addEventListener('click', () => this.show(this.index + Number(button.dataset.dir)));
        });
        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => this.show(Number(dot.dataset.index)));
        });
        const delay = Number(this.getAttribute('autoplay') || 0) * 1000;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (delay > 0 && this.slides.length > 1 && !reduce) {
          this.timer = setInterval(() => this.show(this.index + 1), delay);
        }
      }

      show(next) {
        if (!this.slides.length) return;
        this.index = (next + this.slides.length) % this.slides.length;
        this.slides.forEach((slide, index) => {
          const active = index === this.index;
          slide.classList.toggle('is-active', active);
          slide.toggleAttribute('inert', !active);
        });
        this.dots.forEach((dot, index) => {
          const active = index === this.index;
          dot.classList.toggle('is-active', active);
          dot.setAttribute('aria-selected', active ? 'true' : 'false');
        });
      }
    }

    customElements.define('kuwayt-hero', KuwaytHero);
  }
{% endjavascript %}

{% schema %}
{
  "name": "KUWAYT hero",
  "tag": "section",
  "class": "kuwayt-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
  {
    "type": "url",
    "id": "side_banner_link",
    "label": "Right side banner link"
  },
  {
    "type": "url",
    "id": "bottom_banner_link",
    "label": "Bottom banner link"
  },
  {
    "type": "image_picker",
    "id": "side_banner_1",
    "label": "Right side banner 1"
  },
{
  "type": "image_picker",
  "id": "side_banner_2",
  "label": "Right side banner 2"
},
{
  "type": "image_picker",
  "id": "bottom_banner",
  "label": "Bottom wide banner"
},
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds between slides",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Fallback eyebrow",
      "default": "One stop for all"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "default": "Everything you need, in one store."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Fallback text"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Fallback button",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Fallback link"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Fallback image alt",
      "default": "KUWAYT, one stop for all"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "One store. Every department."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Shop tech, accessories, beauty and clothing from one catalog."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KUWAYT hero"
    }
  ]
}
{% endschema %}
