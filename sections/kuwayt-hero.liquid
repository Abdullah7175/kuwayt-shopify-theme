{%- liquid
  assign hero_heading = section.settings.heading
  assign hero_text = section.settings.text
  assign image_alt = section.settings.image_alt | default: hero_heading
-%}

<div
  class="kuwayt-hero"
  style="
    --kuwayt-hero-pad-top: {{ section.settings.padding_top }}px;
    --kuwayt-hero-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="kuwayt-hero__inner section section--page-width">
    <div class="kuwayt-hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="kuwayt-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if hero_heading != blank %}
        <h1 class="kuwayt-hero__heading">{{ hero_heading | escape }}</h1>
      {% endif %}
      {% if hero_text != blank %}
        <div class="kuwayt-hero__text rte">{{ hero_text }}</div>
      {% endif %}
      <div class="kuwayt-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a class="button kuwayt-hero__button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
            {{ section.settings.primary_label | escape }}
          </a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="button-secondary kuwayt-hero__button" href="{{ section.settings.secondary_link | default: '#kuwayt-shop-categories' }}">
            {{ section.settings.secondary_label | escape }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="kuwayt-hero__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '480, 720, 960, 1200, 1600',
            sizes: '(min-width: 990px) 46vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: image_alt,
            class: 'kuwayt-hero__image',
            width: section.settings.image.width,
            height: section.settings.image.height
        }}
      {% else %}
        <img
          class="kuwayt-hero__image"
          src="{{ 'kuwayt_primary_logo_high_res.png' | asset_url }}"
          alt="{{ image_alt | escape }}"
          width="1600"
          height="640"
          loading="eager"
          fetchpriority="high"
        >
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .kuwayt-hero {
    background:
      radial-gradient(circle at 12% 0%, rgb(0 158 170 / 12%), transparent 36%),
      #fff;
    padding-block: var(--kuwayt-hero-pad-top) var(--kuwayt-hero-pad-bottom);
  }

  .kuwayt-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }

  .kuwayt-hero__eyebrow {
    margin: 0 0 0.75rem;
    color: #009eaa;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .kuwayt-hero__heading {
    margin: 0;
    max-width: 12ch;
    color: #202124;
    font-size: clamp(2.4rem, 4.6vw, 4.25rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .kuwayt-hero__text {
    max-width: 42ch;
    margin: 1rem 0 0;
    color: #3c4043;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .kuwayt-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .kuwayt-hero__button {
    min-height: 2.75rem;
  }

  .kuwayt-hero__media {
    overflow: hidden;
    border-radius: 1.25rem;
    box-shadow: 0 18px 50px rgb(0 158 170 / 16%);
  }

  .kuwayt-hero__image {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (max-width: 989px) {
    .kuwayt-hero__inner {
      grid-template-columns: 1fr;
    }

    .kuwayt-hero__heading {
      max-width: 16ch;
    }

    .kuwayt-hero__media {
      order: -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KUWAYT hero",
  "tag": "section",
  "class": "kuwayt-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "One stop for all"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything you need, in one store."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Shop electronics, fashion, home, beauty, fitness and everyday essentials. Search the catalog, browse a department, and check out once.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "Shop all products"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "Browse categories"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. The KUWAYT banner is used until you choose an image."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "KUWAYT, one stop for all"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "KUWAYT hero",
      "category": "Banners"
    }
  ]
}
{% endschema %}
