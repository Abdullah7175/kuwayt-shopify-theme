<div class="kuwayt-details" {{ section.shopify_attributes }}>
  <div class="section section--page-width">
    {% if section.settings.heading != blank %}
      <h2 class="kuwayt-details__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% for block in section.blocks %}
      {% if block.settings.title != blank and block.settings.text != blank %}
        <details class="kuwayt-details__item" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.title | escape }}</summary>
          <div class="rte">{{ block.settings.text }}</div>
        </details>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Product notes",
  "tag": "section",
  "class": "kuwayt-details-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping and returns"
    }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Note",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Shipping options are confirmed at checkout. Published shipping and refund policies are linked in the footer.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product notes"
    }
  ]
}
{% endschema %}
