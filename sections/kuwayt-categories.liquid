{%- liquid
  assign ready_count = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign ready_count = ready_count | plus: 1
    endif
  endfor

  assign show_section = true
  if section.settings.hide_until_collections and ready_count == 0
    assign show_section = false
  endif
-%}

{% if show_section or request.design_mode %}
  <div
    class="kuwayt-categories kuwayt-categories--{{ section.settings.layout }}"
    {% if section.settings.anchor_id != blank %}
      id="{{ section.settings.anchor_id | escape }}"
    {% endif %}
    style="--kuwayt-categories-pad: {{ section.settings.padding }}px;"
    {{ section.shopify_attributes }}
  >
    <div class="section section--page-width">
      <header class="kuwayt-categories__header">
        {% if section.settings.heading != blank %}
          <h2 class="kuwayt-categories__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="kuwayt-categories__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </header>

      {% if request.design_mode and section.settings.hide_until_collections and ready_count == 0 %}
        <p class="kuwayt-editor-note">Assign a collection to at least one card. This section stays hidden on the storefront until then.</p>
      {% endif %}

      <div class="kuwayt-categories__grid">
        {% for block in section.blocks %}
          {% liquid
            assign category_collection = block.settings.collection
            assign label = block.settings.title
            if category_collection != blank and category_collection.title != blank
              assign label = category_collection.title
            endif
            assign category_url = routes.search_url | append: '?type=product&q=' | append: label | url_encode
            if category_collection != blank
              assign category_url = category_collection.url
            endif
            assign category_image = block.settings.image
            if category_image == blank and category_collection != blank
              assign category_image = category_collection.featured_image | default: category_collection.image
            endif
            assign initial = label | slice: 0, 1 | upcase
            assign hide_card = false
            if section.settings.hide_until_collections and category_collection == blank and request.design_mode == false
              assign hide_card = true
            endif
          %}
          {% unless hide_card or label == blank %}
            <a
              class="kuwayt-category"
              href="{{ category_url }}"
              style="--kuwayt-category-accent: {{ block.settings.accent }}; --kuwayt-category-ink: {{ block.settings.ink }};"
              {{ block.shopify_attributes }}
            >
              <span class="kuwayt-category__media">
                {% if category_image != blank %}
                  {{
                    category_image
                    | image_url: width: 640
                    | image_tag:
                      widths: '160, 240, 320, 480, 640',
                      sizes: '(min-width: 990px) 18vw, 40vw',
                      loading: 'lazy',
                      alt: '',
                      class: 'kuwayt-category__image',
                      width: category_image.width,
                      height: category_image.height
                  }}
                {% else %}
                  <span class="kuwayt-category__mark" aria-hidden="true">{{ initial }}</span>
                {% endif %}
              </span>
              <span class="kuwayt-category__label">{{ label | escape }}</span>
              {% if section.settings.layout == 'cards' %}
                <span class="kuwayt-category__action">Shop</span>
              {% endif %}
            </a>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .kuwayt-categories {
    padding-block: var(--kuwayt-categories-pad);
    background: #fff;
  }

  .kuwayt-categories__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.25rem;
  }

  .kuwayt-categories__heading {
    margin: 0;
    color: #202124;
    font-size: clamp(1.5rem, 2vw, 2rem);
    letter-spacing: -0.02em;
  }

  .kuwayt-categories__subheading {
    margin: 0;
    color: #5f6368;
    font-size: 0.9375rem;
  }

  .kuwayt-categories__grid {
    display: grid;
    gap: 0.875rem;
  }

  .kuwayt-categories--circles .kuwayt-categories__grid {
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  .kuwayt-categories--cards .kuwayt-categories__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .kuwayt-category {
    display: flex;
    min-width: 0;
    color: #202124;
    text-decoration: none;
  }

  .kuwayt-categories--circles .kuwayt-category {
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    text-align: center;
  }

  .kuwayt-categories--circles .kuwayt-category__media {
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 7.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: var(--kuwayt-category-accent);
    color: var(--kuwayt-category-ink);
  }

  .kuwayt-categories--cards .kuwayt-category {
    flex-direction: column;
    justify-content: space-between;
    min-height: 11.5rem;
    padding: 1rem;
    border-radius: 1rem;
    background: var(--kuwayt-category-accent);
    color: var(--kuwayt-category-ink);
  }

  .kuwayt-categories--cards .kuwayt-category__media {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    overflow: hidden;
    border-radius: 0.8rem;
    background: rgb(255 255 255 / 28%);
  }

  .kuwayt-category__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kuwayt-category__mark {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .kuwayt-category__label {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .kuwayt-categories--cards .kuwayt-category__label {
    margin-top: 1rem;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .kuwayt-category__action {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .kuwayt-category:hover .kuwayt-category__label {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .kuwayt-category:focus-visible {
    outline: 2px solid #009eaa;
    outline-offset: 3px;
  }

  @media screen and (max-width: 989px) {
    .kuwayt-categories--circles .kuwayt-categories__grid,
    .kuwayt-categories--cards .kuwayt-categories__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .kuwayt-categories__grid {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 7.25rem;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.35rem;
    }

    .kuwayt-categories--cards .kuwayt-categories__grid {
      grid-auto-columns: 72%;
    }

    .kuwayt-category {
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KUWAYT categories",
  "tag": "section",
  "class": "kuwayt-categories-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose a department. Each card uses a live collection when you assign one."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "circles", "label": "Circles" },
        { "value": "cards", "label": "Cards" }
      ],
      "default": "circles"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID"
    },
    {
      "type": "checkbox",
      "id": "hide_until_collections",
      "label": "Hide until collections are assigned",
      "default": false
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "accent",
          "label": "Color",
          "default": "#009EAA"
        },
        {
          "type": "color",
          "id": "ink",
          "label": "Text",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "KUWAYT categories",
      "category": "Collections"
    }
  ]
}
{% endschema %}
