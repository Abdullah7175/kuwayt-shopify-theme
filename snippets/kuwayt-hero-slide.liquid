{%- liquid
  assign slide_link = block.settings.button_link | default: routes.all_products_collection_url
  assign slide_alt = block.settings.alt | default: block.settings.heading
  assign image_loading = 'lazy'
  assign stage = false
  if index == 0
    assign image_loading = 'eager'
  endif
  if block.settings.video == blank and block.settings.image == blank
    assign stage = true
  endif
-%}
<article
  class="kuwayt-hero__slide{% if stage %} kuwayt-hero__slide--stage{% endif %}{% if active %} is-active{% endif %}"
  {% unless active %}
    inert
  {% endunless %}
  {{ block.shopify_attributes }}
>
  <div class="kuwayt-hero__media">
    {% if block.settings.video != blank %}
      {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1600x' }}
    {% elsif block.settings.image != blank %}
      {{
        block.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '600, 900, 1400, 2000, 2400',
          sizes: '100vw',
          loading: image_loading,
          alt: slide_alt,
          class: 'kuwayt-hero__image kuwayt-hero__image--desktop',
          width: block.settings.image.width,
          height: block.settings.image.height
      }}
      {% if block.settings.mobile_image != blank %}
        {{
          block.settings.mobile_image
          | image_url: width: 1200
          | image_tag:
            widths: '400, 600, 900, 1200',
            sizes: '100vw',
            loading: 'lazy',
            alt: '',
            class: 'kuwayt-hero__image kuwayt-hero__image--mobile',
            width: block.settings.mobile_image.width,
            height: block.settings.mobile_image.height
        }}
      {% endif %}
    {% else %}
      <div class="kuwayt-hero__stage" aria-hidden="true">
        <span class="kuwayt-hero__orb kuwayt-hero__orb--teal"></span>
        <span class="kuwayt-hero__orb kuwayt-hero__orb--gold"></span>
        <span class="kuwayt-hero__orb kuwayt-hero__orb--green"></span>
      </div>
    {% endif %}
  </div>
  <div class="kuwayt-hero__copy section section--page-width">
    {% if block.settings.eyebrow != blank %}
      <p class="kuwayt-hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if block.settings.heading != blank %}
      {% if index == 0 %}
        <h1 class="kuwayt-hero__heading">{{ block.settings.heading | escape }}</h1>
      {% else %}
        <p class="kuwayt-hero__heading">{{ block.settings.heading | escape }}</p>
      {% endif %}
    {% endif %}
    {% if block.settings.text != blank %}
      <p class="kuwayt-hero__text">{{ block.settings.text | escape }}</p>
    {% endif %}
    {% if block.settings.button_label != blank %}
      <a class="button kuwayt-hero__button" href="{{ slide_link }}">{{ block.settings.button_label | escape }}</a>
    {% endif %}
  </div>
</article>
