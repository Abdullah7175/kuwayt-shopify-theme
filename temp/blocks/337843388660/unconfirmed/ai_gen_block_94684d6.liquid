{% doc %}
  @prompt
    heyy i want to show filter on my home page which help me in categories pricese etc 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-home-filter-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin-inline: auto; color: #202124; font-family: inherit; }
  .ai-home-filter-{{ ai_gen_id }}__heading { margin: 0 0 20px; font-size: 28px; line-height: 1.2; }
  .ai-home-filter-{{ ai_gen_id }}__controls { display: flex; flex-wrap: wrap; align-items: end; gap: 16px; padding: 18px; margin-bottom: 24px; background: #f3fbfc; border: 1px solid #e4e7ea; border-radius: 12px; }
  .ai-home-filter-{{ ai_gen_id }}__field { display: grid; gap: 7px; min-width: 180px; flex: 1 1 180px; }
  .ai-home-filter-{{ ai_gen_id }}__label { font-size: 14px; font-weight: 600; }
  .ai-home-filter-{{ ai_gen_id }}__select { width: 100%; min-height: 44px; padding: 9px 12px; color: #202124; background: #fff; border: 1px solid #73777c; border-radius: 8px; font: inherit; }
  .ai-home-filter-{{ ai_gen_id }}__range-wrap { display: flex; align-items: center; gap: 12px; }
  .ai-home-filter-{{ ai_gen_id }}__range { width: 100%; accent-color: #007983; }
  .ai-home-filter-{{ ai_gen_id }}__amount { min-width: 85px; font-size: 14px; font-weight: 600; }
  .ai-home-filter-{{ ai_gen_id }}__results { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; }
  .ai-home-filter-{{ ai_gen_id }}__card { min-width: 0; color: inherit; text-decoration: none; border: 1px solid #e4e7ea; border-radius: 8px; overflow: hidden; }
  .ai-home-filter-{{ ai_gen_id }}__image { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #f3f4f4; }
  .ai-home-filter-{{ ai_gen_id }}__image svg { width: 100%; height: 100%; }
  .ai-home-filter-{{ ai_gen_id }}__card-info { padding: 12px; }
  .ai-home-filter-{{ ai_gen_id }}__product-title { margin: 0 0 6px; font-size: 15px; line-height: 1.35; }
  .ai-home-filter-{{ ai_gen_id }}__price { font-size: 14px; font-weight: 600; }
  .ai-home-filter-{{ ai_gen_id }}__empty { padding: 24px; text-align: center; background: #f3fbfc; border-radius: 8px; }
  .ai-home-filter-{{ ai_gen_id }}__card[hidden] { display: none; }
  @media (max-width: 600px) { .ai-home-filter-{{ ai_gen_id }} { width: 100%; } .ai-home-filter-{{ ai_gen_id }}__controls { align-items: stretch; } .ai-home-filter-{{ ai_gen_id }}__field { min-width: 100%; } .ai-home-filter-{{ ai_gen_id }}__heading { font-size: 23px; } }
{% endstyle %}

<home-product-filter-{{ ai_gen_id }} class="ai-home-filter-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-home-filter-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.collection != blank %}
    <div class="ai-home-filter-{{ ai_gen_id }}__controls">
      <div class="ai-home-filter-{{ ai_gen_id }}__field"><label class="ai-home-filter-{{ ai_gen_id }}__label" for="ai-category-{{ ai_gen_id }}">Category</label><select class="ai-home-filter-{{ ai_gen_id }}__select" id="ai-category-{{ ai_gen_id }}" data-category><option value="all">All categories</option></select></div>
      <div class="ai-home-filter-{{ ai_gen_id }}__field"><label class="ai-home-filter-{{ ai_gen_id }}__label" for="ai-price-{{ ai_gen_id }}">Maximum price</label><div class="ai-home-filter-{{ ai_gen_id }}__range-wrap"><input class="ai-home-filter-{{ ai_gen_id }}__range" id="ai-price-{{ ai_gen_id }}" data-price type="range" min="0" max="{{ block.settings.max_price }}" step="100" value="{{ block.settings.max_price }}" aria-describedby="ai-amount-{{ ai_gen_id }}"><output class="ai-home-filter-{{ ai_gen_id }}__amount" id="ai-amount-{{ ai_gen_id }}" data-amount>{{ block.settings.max_price | money_without_currency }}</output></div></div>
    </div>
    <div class="ai-home-filter-{{ ai_gen_id }}__results" data-results>
      {% for product in block.settings.collection.products limit: 50 %}
        <a class="ai-home-filter-{{ ai_gen_id }}__card" href="{{ product.url }}" data-product-card data-type="{{ product.type | escape }}" data-price="{{ product.price }}">
          {% if product.featured_image %}<img class="ai-home-filter-{{ ai_gen_id }}__image" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="600" height="600">{% else %}<div class="ai-home-filter-{{ ai_gen_id }}__image">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
          <div class="ai-home-filter-{{ ai_gen_id }}__card-info"><h3 class="ai-home-filter-{{ ai_gen_id }}__product-title">{{ product.title | escape }}</h3><span class="ai-home-filter-{{ ai_gen_id }}__price">{{ product.price | money }}</span></div>
        </a>
      {% else %}<p class="ai-home-filter-{{ ai_gen_id }}__empty">This collection has no products yet.</p>{% endfor %}
    </div>
    <p class="ai-home-filter-{{ ai_gen_id }}__empty" data-no-results hidden>No products match these filters.</p>
  {% else %}<div class="ai-home-filter-{{ ai_gen_id }}__empty">Choose a collection in this block's settings to show products and filters.</div>{% endif %}
</home-product-filter-{{ ai_gen_id }}>

<script>
  (function() {
    const elementName = 'home-product-filter-{{ ai_gen_id }}';
    if (customElements.get(elementName)) return;
    class HomeProductFilter{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        const category = this.querySelector('[data-category]');
        const price = this.querySelector('[data-price]');
        const amount = this.querySelector('[data-amount]');
        const cards = Array.from(this.querySelectorAll('[data-product-card]'));
        const empty = this.querySelector('[data-no-results]');
        if (!category || !price || !amount) return;
        [...new Set(cards.map(card => card.dataset.type.trim()).filter(Boolean))].sort((a, b) => a.localeCompare(b)).forEach(type => {
          const option = document.createElement('option'); option.value = type; option.textContent = type; category.appendChild(option);
        });
        const formatPrice = value => new Intl.NumberFormat(undefined, { maximumFractionDigits: 0 }).format(value);
        const applyFilters = () => {
          let visible = 0;
          cards.forEach(card => {
            const matchType = category.value === 'all' || card.dataset.type.trim() === category.value;
            card.hidden = !(matchType && Number(card.dataset.price) <= Number(price.value) * 100);
            if (!card.hidden) visible += 1;
          });
          if (empty) empty.hidden = visible !== 0;
          amount.textContent = formatPrice(Number(price.value));
        };
        category.addEventListener('change', applyFilters);
        price.addEventListener('input', applyFilters);
        applyFilters();
      }
    }
    customElements.define(elementName, HomeProductFilter{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Home product filters",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find products" },
    { "type": "collection", "id": "collection", "label": "Product collection" },
    { "type": "range", "id": "max_price", "label": "Maximum price", "min": 0, "max": 9900, "step": 100, "unit": "PKR", "default": 9900 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Home product filters" }],
  "tag": null,
  "class": "home-product-filters-block"
}
{% endschema %}